# Dockerfile.debank - DeBank fork of Tempo, builds only the `tempo` binary.
# Based on upstream Dockerfile.chef + Dockerfile pattern, simplified for DeBank CI.

FROM rust:1.96-bookworm AS chef

RUN cargo install --locked cargo-chef sccache

WORKDIR /app

FROM chef AS planner

COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder

ARG TARGETARCH
ARG RUST_PROFILE=release
ARG RUST_FEATURES="asm-keccak,jemalloc"
ARG EXTRA_RUSTFLAGS=""

ENV VERGEN_DEFAULT_ON_ERROR=1

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
    pkg-config \
    libssl-dev \
    build-essential \
    clang \
    libclang-dev \
    mold \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTC_WRAPPER=sccache \
    SCCACHE_DIR=/sccache \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=clang \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=clang

COPY --from=planner /app/recipe.json recipe.json

# Cook dependencies first (cached layer)
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked,id=cargo-registry-${TARGETARCH} \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked,id=cargo-git-${TARGETARCH} \
    --mount=type=cache,target=$SCCACHE_DIR,sharing=locked,id=sccache-${TARGETARCH} \
    RUSTFLAGS="-C link-arg=-fuse-ld=mold ${EXTRA_RUSTFLAGS}" \
    cargo chef cook --profile ${RUST_PROFILE} --features "${RUST_FEATURES}" --recipe-path recipe.json

# Build the tempo binary
COPY . .

# Source metadata must not invalidate the dependency-cooking layer.
ARG VERGEN_GIT_SHA
ARG VERGEN_GIT_SHA_SHORT
ENV VERGEN_GIT_SHA=${VERGEN_GIT_SHA} \
    VERGEN_GIT_SHA_SHORT=${VERGEN_GIT_SHA_SHORT}

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked,id=cargo-registry-${TARGETARCH} \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked,id=cargo-git-${TARGETARCH} \
    --mount=type=cache,target=$SCCACHE_DIR,sharing=locked,id=sccache-${TARGETARCH} \
    RUSTFLAGS="-C link-arg=-fuse-ld=mold ${EXTRA_RUSTFLAGS}" \
    cargo build --profile ${RUST_PROFILE} --features "${RUST_FEATURES}" --bin tempo

RUN cp /app/target/${RUST_PROFILE}/tempo /app/tempo

# Runtime image
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /data

COPY --from=builder /app/tempo /usr/local/bin/tempo

EXPOSE 30303 30303/udp 9001 8545 8546
ENTRYPOINT ["/usr/local/bin/tempo"]
